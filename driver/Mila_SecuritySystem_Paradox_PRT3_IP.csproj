<!--
  קובץ הפרויקט של הדרייבר ל-Crestron Certified Driver.

  שם הקובץ עוקב אחר מוסכמת Crestron:
    <Developer>_<DeviceType>_<Manufacturer>_<BaseModel>_<Communication>
    = Mila_SecuritySystem_Paradox_PRT3_IP

  ── בנייה (מדריך מלא "מאפס" ב-docs/מדריך-Paradox-Crestron.html, פרק 5) ──
  1. התקן Visual Studio 2022 Community (חינם), עם Workload בשם
     ".NET desktop development".
  2. פתח את הקובץ הזה: File → Open → Project/Solution.
  3. שתי חבילות ה-NuGet למטה יותקנו אוטומטית (Restore) בפתיחה. אם לא —
     Tools → NuGet Package Manager → Manage NuGet Packages → Browse →
     התקן: Crestron.DeviceDrivers.DevKit + Crestron.DeviceDrivers.ManifestUtil.
  4. בחר Release בסרגל העליון.
  5. Build → Build Solution (Ctrl+Shift+B).
  6. קובץ ה-.pkg נוצר אוטומטית תחת bin\Release\ (חבילת ManifestUtil יוצרת אותו).

  אין צורך לערוך HintPath או להריץ ManifestUtil ידנית — חבילות ה-NuGet
  מטפלות בכל זה. הסמל CRESTRON_RAD מפעיל את שכבת הקישור ל-SDK
  (ParadoxPrt3SecurityDriver.cs); בלעדיו נבנים רק קבצי הליבה חסרי-התלות.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- דרייברים ל-Crestron נבנים ל-.NET Framework 4.7.2 -->
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Mila_SecuritySystem_Paradox_PRT3_IP</AssemblyName>
    <RootNamespace>Mila.Paradox.Prt3</RootNamespace>
    <Configuration Condition="'$(Configuration)'==''">Release</Configuration>
    <!-- הסר את הסמל אם רוצים לבנות רק את הליבה ללא תלות ב-SDK -->
    <DefineConstants>CRESTRON_RAD</DefineConstants>
  </PropertyGroup>

  <!-- חבילות ה-SDK של Crestron (ציבוריות ב-nuget.org).
       התאם את הגרסה ל-SDK שהתקנת. עבור SDK v28.0000.0015 בחר את גרסת ה-NuGet
       ה-28.x האחרונה (ב-Package Manager פשוט בחר "Latest"). המספר למטה הוא
       ברירת מחדל שאפשר לעדכן. -->
  <ItemGroup>
    <PackageReference Include="Crestron.DeviceDrivers.DevKit" Version="28.*" />
    <PackageReference Include="Crestron.DeviceDrivers.ManifestUtil" Version="28.*" />
  </ItemGroup>

</Project>
